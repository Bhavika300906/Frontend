        .fw-bold {
            word-break: break-word;
            color: rgb(51, 51, 51);
            font-family: Roboto;
            font-size: 24px;
            font-weight: 700;
            line-height: 1.17;
        }

        .m-name {
            font-weight: 600;
            font-family: 'Roboto', sans-serif;
            font-size: 1.3vw;
            margin-top: 8px;
            margin-bottom: 2px;
        }

        .small {
            color: #6c757d;
            font-family: 'Roboto', sans-serif;
            font-size: vw;
        }


        .movie-row {
            position: relative;
        }

        .movie-container {
            display: flex;
            overflow-x: auto;
            scroll-behavior: smooth;
            gap: 1rem;
            padding-bottom: 10px;
        }
