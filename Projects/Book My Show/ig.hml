.carousel img {
            height: 350px;
            /* Adjust banner height */
            object-fit: cover;
            /* Maintain aspect ratio */
            border-radius: 10px;
        }

        .carousel-indicators [data-bs-target] {
            background-color: #dc3545;
            /* BookMyShow red */
        }

        .carousel-control-prev-icon,
        .carousel-control-next-icon {
            filter: invert(1);
            /* Make controls visible on dark images */
        }
